# .coveragerc - Coverage.py configuration for HRMS

[run]
# Source code directories to measure
source = .

# Omit these files/directories from coverage
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */env/*
    .eggs/*
    setup.py
    */grpc_services/proto/*_pb2*.py
    */.nicegui/*
    build/*
    dist/*

# Branch coverage
branch = True

# Enable parallel mode for faster execution
parallel = True

[report]
# Show lines that weren't executed
show_missing = True

# Skip files with 100% coverage
skip_covered = False

# Ignore errors for missing source files
ignore_errors = True

# Precision for coverage percentage
precision = 2

# Sort by coverage percentage
sort = Cover

# Exclude lines from coverage
exclude_lines =
    # Standard pragma
    pragma: no cover
    
    # Debug code
    def __repr__
    def __str__
    
    # Defensive programming
    raise AssertionError
    raise NotImplementedError
    
    # Type checking
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    
    # Abstract methods
    @abstractmethod
    
    # Main entry points
    if __name__ == .__main__.:
    
    # Pass statements
    pass
    
    # Ellipsis
    \.\.\.

[html]
# Directory for HTML coverage report
directory = htmlcov
title = HRMS Test Coverage Report

[xml]
# Output file for XML coverage report (for CI/CD)
output = coverage.xml

[json]
# Output file for JSON coverage report
output = coverage.json
show_contexts = True
